{
  "functions": {
    "api/*.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com; frame-src https://vanilla-1c9bb.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/mime.mjs", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/master-resume.mjs", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/gmail-error.mjs", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/http-error.mjs", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/firebase-init.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/style.css", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
